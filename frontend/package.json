{
  "name": "reelos-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node scripts/patch-meteor-sdk.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/patch-meteor-sdk.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "decode-uri-component": "0.5.1"
  }
}
