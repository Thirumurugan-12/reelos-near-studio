# Keep real credentials in .env. Never use NEXT_PUBLIC_ for provider keys.
MODEL_API_KEY=
META_MUSE_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
REELOS_DATA_DIR=data
# Conservative reservation per request; configure only after checking account pricing.
# Enable a positive budget intentionally only when running fresh AI inference.
REELOS_API_BUDGET_USD=0
REELOS_REQUEST_RESERVE_USD=1
# Graphic-insert renderer: hyperframes (default) or remotion (fallback)
REELOS_GRAPHICS_RENDERER=hyperframes

# Optional NEAR escrow: leave blank until deployed to a named testnet account.
REELOS_NEAR_CONTRACT_ID=
